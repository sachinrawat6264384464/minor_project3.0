# Application Settings
PROJECT_NAME="AI Research Paper & Research Gap Finder"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="replace_with_a_secure_secret_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with pgvector or SQLite fallback for dev)
DATABASE_URL="sqlite:///./research_platform.db"
# Production Postgres with pgvector:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/research_gap_db"

# Academic Discovery APIs (Optional, system falls back to mock/OpenAlex if missing)
SERPAPI_API_KEY=""
SEMANTIC_SCHOLAR_API_KEY=""

# OpenAI API Settings
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o-mini"
EXTRACTION_LLM_MODEL="gpt-4o-mini"

# Embedding Model
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
USE_LOCAL_EMBEDDINGS=true

# Storage Settings
UPLOAD_DIR="./storage/uploads"
MAX_UPLOAD_SIZE_MB=50
